# LumenBOT asks for an update now with an empty file in its runtime directory. This starts
# lumenbot-update-request.service as root, which removes the file and never reads it.
[Unit]
Description=Watch for an LumenBOT update request

[Path]
PathExists=/run/lumenbot/update-stage
PathExists=/run/lumenbot/update-install

[Install]
WantedBy=paths.target
