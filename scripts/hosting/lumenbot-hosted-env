#!/bin/bash
# The create-time setup script of a hosted server runs this as the sandbox user, with the sandbox
# env that the account server set. boat does not give that env to systemd, so this copies the two
# hosted variables to a 0600 file that lumenbot-hosted-server waits for.
#
# The claim stays in the file after the first start. Until its first use, each start of the server makes it work for
# one hour. After its first use it works for 10 minutes. LumenBOT removes it from the environment that agents inherit.
set -euo pipefail
umask 077

[[ ${LUMENBOT_HOSTED_HOST_ID:-} =~ ^[0-9a-fA-F-]{36}$ ]] || { echo "LUMENBOT_HOSTED_HOST_ID is missing." >&2; exit 1; }
[ -n "${LUMENBOT_HOSTED_CLAIM:-}" ] || { echo "LUMENBOT_HOSTED_CLAIM is missing." >&2; exit 1; }
[[ $LUMENBOT_HOSTED_CLAIM =~ ^[A-Za-z0-9_-]+$ ]] || { echo "LUMENBOT_HOSTED_CLAIM is not valid." >&2; exit 1; }

directory="$HOME/.config/lumenbot-hosted"
mkdir -p "$directory"
chmod 0700 "$directory"
temporary=$(mktemp "$directory/env.XXXXXX")
printf 'LUMENBOT_HOSTED_HOST_ID=%s\nLUMENBOT_HOSTED_CLAIM=%s\n' "$LUMENBOT_HOSTED_HOST_ID" "$LUMENBOT_HOSTED_CLAIM" >"$temporary"
mv -f "$temporary" "$directory/env"
