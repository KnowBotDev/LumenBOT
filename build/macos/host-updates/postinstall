#!/bin/sh
set -eu
export PATH=/usr/bin:/bin:/usr/sbin:/sbin LC_ALL=C
ROOT='/Library/Application Support/LumenBOT/HostManager'
"$ROOT/lumenbot-host" --verify-installation
# Payload files have explicit root:wheel modes. Never recurse through tenant status or homes.
if [ -f "$ROOT/config.json" ] && [ ! -L "$ROOT/config.json" ]; then
  launchctl bootstrap system /Library/LaunchDaemons/app.lumenbot.host-manager.plist
fi
echo 'LumenBOT Host installed. Run sudo lumenbot-host setup, then sudo lumenbot-host verify.'
